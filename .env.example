# ===== Identitas (dipakai untuk nama container) =====
NAMA=nama-kamu

# ===== PostgreSQL (ketentuan soal: user postgres / password ifunggul) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password
POSTGRES_DB=kampus_db

# ===== Port eksternal: 22XXX dan 44XXX, XXX = 3 digit terakhir NIM 1247050086 -> 086 =====
PG_PORT=22086
PGADMIN_PORT=44086

# ===== pgAdmin4 =====
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=ganti_dengan_password

# ===== Password role aplikasi (dipakai 01_setup.sql & tests) =====
BACKEND_DEV_PASSWORD=ganti_dengan_password
BI_DEV_PASSWORD=ganti_dengan_password
DATA_ENGINEER_PASSWORD=ganti_dengan_password
